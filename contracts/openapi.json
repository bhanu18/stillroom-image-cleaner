  "components": {
    "schemas": {
      "Box": {
        "properties": {
          "x_min": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X Min"
          },
          "y_min": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y Min"
          },
          "x_max": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X Max"
          },
          "y_max": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y Max"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x_min",
          "y_min",
          "x_max",
          "y_max"
        ],
        "title": "Box"
      },
      "Feedback": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "title": "Reason",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accepted",
          "revision"
        ],
        "title": "Feedback"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Inpaint": {
        "properties": {
          "erase_mask_asset_id": {
            "type": "string",
            "format": "uuid",
            "title": "Erase Mask Asset Id"
          },
          "method": {
            "type": "string",
            "const": "classical",
            "title": "Method",
            "default": "classical"
          },
          "feather_px": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 0.0,
            "title": "Feather Px",
            "default": 2
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "erase_mask_asset_id"
        ],
        "title": "Inpaint"
      },
      "JobRequest": {
        "properties": {
          "input_asset_id": {
            "type": "string",
            "format": "uuid",
            "title": "Input Asset Id"
          },
          "segmentation": {
            "$ref": "#/components/schemas/Segmentation"
          },
          "restoration": {
            "$ref": "#/components/schemas/Restoration"
          },
          "upscale": {
            "$ref": "#/components/schemas/Upscale"
          },
          "output": {
            "$ref": "#/components/schemas/Output"
          },
          "memory": {
            "$ref": "#/components/schemas/Memory"
          },
          "inpaint": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Inpaint"
              },
              {
                "type": "null"
              }
